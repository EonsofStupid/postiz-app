# Safe template for one fuqn.ai Postiz instance.
# Copy this file to deploy/fuqn/.env and replace every placeholder.
# .env is gitignored. Do not commit real values.
#
# Generate each secret with: openssl rand -hex 32
# Use hex so the values are safe inside DATABASE_URL and REDIS_URL.
# The entrypoint rejects the placeholder text, short JWT secrets, empty
# database passwords, and Redis without a password.

# Host port. It is bound to 127.0.0.1 only.
FUQN_BIND_PORT=4007

# Application Postgres (postgres:17-alpine, not published on the host).
FUQN_POSTGRES_USER=fuqn_app
FUQN_POSTGRES_PASSWORD=replace-with-a-long-random-secret
FUQN_POSTGRES_DB=fuqn

# Redis 7.2 (not published on the host). The password is required.
FUQN_REDIS_PASSWORD=replace-with-a-long-random-secret

# Temporal's own Postgres (postgres:16-alpine, separate from application data).
FUQN_TEMPORAL_POSTGRES_USER=fuqn_temporal
FUQN_TEMPORAL_POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Required by the application container. Compose sets DATABASE_URL, REDIS_URL,
# BACKEND_INTERNAL_URL, TEMPORAL_ADDRESS, UPLOAD_DIRECTORY, and IS_GENERAL.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://127.0.0.1:4007
MAIN_URL=http://127.0.0.1:4007
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4007/api
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
TEMPORAL_ADDRESS=temporal:7233
IS_GENERAL=true

# local serves /uploads from the volume. cloudflare uses R2 (S3-compatible).
# One image supports both. Switching storage does not require a rebuild.
STORAGE_PROVIDER=local
# CLOUDFLARE_ACCOUNT_ID=replace-with-a-long-random-secret
# CLOUDFLARE_ACCESS_KEY=replace-with-a-long-random-secret
# CLOUDFLARE_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
# CLOUDFLARE_BUCKETNAME=your-bucket
# CLOUDFLARE_BUCKET_URL=https://your-bucket.example
# CLOUDFLARE_REGION=auto

# Optional values inlined into the browser bundle. Set them here and recreate
# the app container. Leave them unset to keep the bundle empty for that value.
# NEXT_PUBLIC_POLOTNO=
# NEXT_PUBLIC_DISCORD_SUPPORT=
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=
# NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=
# NEXT_PUBLIC_FACEBOOK_PIXEL=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_TRACKING_TRIAL=

# Leave registration open only long enough to create the first user,
# then set this to true and recreate the app container.
DISABLE_REGISTRATION=false

# Optional provider, email, and billing settings use the same names as
# the repository .env.example. Add them here when you need them.
# Do not put those secrets in the image build.
